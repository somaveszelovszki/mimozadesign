---
import WorkshopsCalendar from '@/components/blocks/workshops-section/workshops-calendar'
import { workshops, pastWorkshopHighlight } from '@/assets/data/workshops'
import Layout from '@/layouts/Layout.astro'

const pageTitle = 'Workshopok | Mimóza Design'
const pageDescription =
  'Kreatív workshop események, szárazvirág kompozíciók és virágcsokor-készítési inspirációk a Mimóza Design-tól.'
const pageKeywords =
  'kreatív workshop, DIY workshop, virág workshop, workshop, szárazvirág kompozíció, virágcsokor, koszorú, Mimóza, Mimóza Design, Veszelovszki-Petró Liza, Petró Liza'

const futureWorkshops = workshops.filter(w => !w.past)

const workshopsCalendarEvents = futureWorkshops.flatMap(workshop =>
  workshop.dates.map(d => ({
    title: workshop.title,
    date: d.date,
    time: d.time,
    location: d.location,
    slug: workshop.slug,
    isPast: false
  }))
)
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <section id='upcoming-workshops' class='bg-muted/40 py-10 sm:py-12 lg:py-14'>
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
      <div class='mb-8 space-y-3'>
        <h2 class='font-serif text-2xl font-semibold sm:text-3xl'>Következő workshopok</h2>
        <p class='text-muted-foreground max-w-3xl text-lg'>Válaszd ki a neked tetsző eseményt és jelentkezz!</p>
      </div>

      <div class='grid grid-cols-1 gap-6'>
        {
          futureWorkshops.flatMap(workshop =>
            workshop.dates.map(d => (
              <article class='border-border hover:border-primary bg-card overflow-hidden rounded-xl border transition-colors duration-300 sm:w-1/2'>
                <a href={`/workshop/${workshop.slug}`} class='group flex flex-col sm:flex-row'>
                  <img
                    src={workshop.coverImage}
                    alt={`${workshop.title} borítókép`}
                    class='h-52 w-full object-cover transition-transform duration-300 group-hover:scale-105 sm:h-auto sm:min-h-52 sm:w-72'
                    loading='lazy'
                  />
                  <div class='space-y-3 p-5'>
                    <h3 class='font-serif text-xl font-medium'>{workshop.title}</h3>
                    <p class='text-muted-foreground text-sm'>
                      {d.date} | {d.time}
                    </p>
                    <p class='text-muted-foreground text-sm'>{d.location}</p>
                    <p class='text-muted-foreground text-sm'>{workshop.price}</p>
                    <span class='text-primary inline-block text-sm font-medium group-hover:underline'>Részletek</span>
                  </div>
                </a>
              </article>
            ))
          )
        }
      </div>
    </div>
  </section>

  <section id='past-highlights' class='bg-background py-8 sm:py-16 lg:py-24'>
    <div class='mx-auto max-w-7xl px-4 sm:px-6 lg:px-8'>
      <div class='mb-8 max-w-2xl space-y-4 sm:mb-12'>
        <h2 class='font-serif text-2xl font-semibold tracking-tight md:text-3xl lg:text-4xl'>
          {pastWorkshopHighlight.title}
        </h2>
        <p class='text-muted-foreground text-xl leading-relaxed'>
          {pastWorkshopHighlight.description}
        </p>
      </div>

      <div
        id='past-highlights-gallery'
        class='columns-2 gap-3 sm:columns-4 sm:gap-4'
        data-images={JSON.stringify(pastWorkshopHighlight.images)}
      >
        {
          pastWorkshopHighlight.images.map((image, index) => (
            <div class='mb-3 break-inside-avoid overflow-hidden rounded-2xl sm:mb-4'>
              <button
                type='button'
                data-gallery-index={index}
                aria-label={`${index + 1}. kép megnyitása`}
                class='focus-visible:ring-ring hover:border-primary group block w-full cursor-pointer rounded-lg border border-transparent transition-colors duration-300 outline-none focus-visible:ring-2 focus-visible:ring-offset-2'
              >
                <img
                  src={image}
                  alt={`Korábbi workshop kép ${index + 1}`}
                  class='h-auto w-full object-cover transition-transform duration-300 group-hover:scale-105'
                  loading='lazy'
                />
              </button>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id='workshops-calendar' class='mx-auto w-full max-w-[74rem] px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-14'>
    <div class='mb-6 space-y-3'>
      <h2 class='font-serif text-2xl font-semibold sm:text-3xl'>Workshop naptár</h2>
      <p class='text-muted-foreground max-w-3xl text-lg'>Interaktív naptár a következő workshop dátumokkal.</p>
    </div>
    <WorkshopsCalendar events={workshopsCalendarEvents} client:visible />
  </section>

  <div
    id='gallery-lightbox'
    class='bg-background/95 fixed inset-0 z-50 hidden items-center justify-center overflow-hidden p-4 backdrop-blur-sm sm:p-8'
    aria-hidden='true'
  >
    <button
      type='button'
      id='gallery-close'
      class='bg-background/70 text-foreground hover:bg-background absolute top-4 right-4 z-10 rounded-full border px-3 py-1.5 text-sm'
      aria-label='Galéria bezárása'
    >
      Bezárás
    </button>

    <button
      type='button'
      id='gallery-prev'
      class='bg-background/70 text-foreground hover:bg-background absolute top-1/2 left-4 z-10 -translate-y-1/2 rounded-full border px-3 py-2 text-2xl leading-none'
      aria-label='Előző kép'
    >
      ‹
    </button>

    <img
      id='gallery-image'
      src=''
      alt=''
      class='max-h-[90vh] w-full max-w-[calc(100vw-2rem)] rounded-2xl object-contain sm:max-w-[calc(100vw-4rem)]'
    />

    <button
      type='button'
      id='gallery-next'
      class='bg-background/70 text-foreground hover:bg-background absolute top-1/2 right-4 z-10 -translate-y-1/2 rounded-full border px-3 py-2 text-2xl leading-none'
      aria-label='Következő kép'
    >
      ›
    </button>
  </div>

  <script is:inline>
    ;(() => {
      const cleanupKey = '__mimozaPastHighlightsGalleryCleanup'

      const initGallery = () => {
        if (typeof window[cleanupKey] === 'function') {
          window[cleanupKey]()
        }

        const gallery = document.querySelector('#past-highlights-gallery')
        const lightbox = document.querySelector('#gallery-lightbox')
        const lightboxImage = document.querySelector('#gallery-image')
        const closeButton = document.querySelector('#gallery-close')
        const prevButton = document.querySelector('#gallery-prev')
        const nextButton = document.querySelector('#gallery-next')

        if (!gallery || !lightbox || !lightboxImage || !closeButton || !prevButton || !nextButton) {
          window[cleanupKey] = null
          return
        }

        const images = JSON.parse(gallery.getAttribute('data-images') || '[]')
        if (!Array.isArray(images) || images.length === 0) {
          window[cleanupKey] = null
          return
        }

        let activeIndex = 0

        const openLightbox = index => {
          activeIndex = index
          lightboxImage.setAttribute('src', images[activeIndex])
          lightboxImage.setAttribute('alt', `${activeIndex + 1}. korábbi workshop kép`)
          lightbox.classList.remove('hidden')
          lightbox.classList.add('flex')
          lightbox.setAttribute('aria-hidden', 'false')
          document.body.style.overflow = 'hidden'
        }

        const closeLightbox = () => {
          lightbox.classList.add('hidden')
          lightbox.classList.remove('flex')
          lightbox.setAttribute('aria-hidden', 'true')
          document.body.style.overflow = ''
        }

        const showRelative = direction => {
          activeIndex = (activeIndex + direction + images.length) % images.length
          lightboxImage.setAttribute('src', images[activeIndex])
          lightboxImage.setAttribute('alt', `${activeIndex + 1}. korábbi workshop kép`)
        }

        const onGalleryClick = event => {
          const trigger = event.target.closest('[data-gallery-index]')
          if (!trigger) {
            return
          }
          const index = Number(trigger.getAttribute('data-gallery-index'))
          if (!Number.isFinite(index)) {
            return
          }
          openLightbox(index)
        }

        const onPrevClick = () => showRelative(-1)
        const onNextClick = () => showRelative(1)

        const onLightboxClick = event => {
          if (event.target === lightbox) {
            closeLightbox()
          }
        }

        const onKeyDown = event => {
          if (lightbox.getAttribute('aria-hidden') === 'true') {
            return
          }
          if (event.key === 'Escape') {
            closeLightbox()
          } else if (event.key === 'ArrowLeft') {
            showRelative(-1)
          } else if (event.key === 'ArrowRight') {
            showRelative(1)
          }
        }

        document.addEventListener('click', onGalleryClick)
        closeButton.addEventListener('click', closeLightbox)
        prevButton.addEventListener('click', onPrevClick)
        nextButton.addEventListener('click', onNextClick)
        lightbox.addEventListener('click', onLightboxClick)
        document.addEventListener('keydown', onKeyDown)

        window[cleanupKey] = () => {
          document.removeEventListener('click', onGalleryClick)
          closeButton.removeEventListener('click', closeLightbox)
          prevButton.removeEventListener('click', onPrevClick)
          nextButton.removeEventListener('click', onNextClick)
          lightbox.removeEventListener('click', onLightboxClick)
          document.removeEventListener('keydown', onKeyDown)
          document.body.style.overflow = ''
        }
      }

      initGallery()
      document.addEventListener('astro:page-load', initGallery)
    })()
  </script>
</Layout>
