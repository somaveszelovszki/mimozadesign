---
import Layout from '@/layouts/Layout.astro'

const pageTitle = 'Kapcsolat | Mimóza Design'
const pageDescription =
  'Lépj kapcsolatba velünk emailen vagy social felületeken, és küldd el üzenetedet az ajánlatkérő űrlapon.'

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY
---

<Layout title={pageTitle} description={pageDescription}>
  <section class='mx-auto w-full max-w-3xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-16'>
    <section class='border-border bg-card rounded-xl border p-6 sm:p-8'>
      <h2 class='font-serif text-2xl font-semibold sm:text-3xl'>Ajánlatkérés</h2>
      <p class='text-muted-foreground mt-3 text-sm sm:text-base'>
        Töltsd ki az űrlapot, és oszd meg velünk, miben segíthetünk.
      </p>

      <form id='contact-form' class='mt-6 space-y-5' method='post' action='/api/contact' enctype='multipart/form-data'>
        {/* Honeypot — hidden from real users; bots fill it and get rejected. */}
        <div aria-hidden='true' style='position:absolute;left:-9999px;top:-9999px;height:0;width:0;overflow:hidden'>
          <label for='website'>Weboldal</label>
          <input id='website' name='website' type='text' tabindex='-1' autocomplete='off' />
        </div>
        {/* Time-trap — set client-side to the time spent filling the form. */}
        <input id='elapsed' name='elapsed' type='hidden' value='0' />

        <div class='space-y-2'>
          <label for='name' class='text-sm font-medium'>Név</label>
          <input
            id='name'
            name='name'
            type='text'
            autocomplete='name'
            placeholder='Tavaszi Jázmin'
            class='border-input bg-background focus:ring-ring w-full rounded-lg border px-4 py-3 text-base focus:ring-2 focus:outline-none'
            required
          />
        </div>

        <div class='space-y-2'>
          <label for='email' class='text-sm font-medium'>Email</label>
          <input
            id='email'
            name='email'
            type='email'
            autocomplete='email'
            placeholder='tavaszi.jazmin@example.com'
            class='border-input bg-background focus:ring-ring w-full rounded-lg border px-4 py-3 text-base focus:ring-2 focus:outline-none'
            required
          />
        </div>

        <div class='space-y-2'>
          <label for='phone' class='text-sm font-medium'>Telefonszám</label>
          <input
            id='phone'
            name='phone'
            type='tel'
            autocomplete='tel'
            placeholder='06 20 123 4567'
            class='border-input bg-background focus:ring-ring w-full rounded-lg border px-4 py-3 text-base focus:ring-2 focus:outline-none'
          />
        </div>

        <div class='space-y-2'>
          <label for='message' class='text-sm font-medium'>Üzenet</label>
          <textarea
            id='message'
            name='message'
            rows={6}
            class='border-input bg-background focus:ring-ring w-full rounded-lg border px-4 py-3 text-base focus:ring-2 focus:outline-none'
            required>Kedves Mimóza!</textarea
          >
        </div>

        <div class='space-y-2'>
          <span class='text-sm font-medium'>Fájlok feltöltése</span>
          <div class='border-input bg-background rounded-lg border border-dashed p-2'>
            <input id='attachment' name='attachment' type='file' multiple class='peer sr-only' />
            <label
              for='attachment'
              class='hover:bg-muted/50 peer-focus-visible:ring-ring flex h-28 w-full cursor-pointer flex-col items-center justify-center gap-2 rounded-md text-center transition-colors peer-focus-visible:ring-2 peer-focus-visible:outline-none'
            >
              <svg
                xmlns='http://www.w3.org/2000/svg'
                viewBox='0 0 24 24'
                width='32'
                height='32'
                fill='none'
                stroke='currentColor'
                stroke-width='1.75'
                stroke-linecap='round'
                stroke-linejoin='round'
                class='text-muted-foreground h-8 w-8 shrink-0'
                aria-hidden='true'
              >
                <path d='M16 16l-4-4-4 4'></path>
                <path d='M12 12v9'></path>
                <path d='M20.4 18.4A5 5 0 0018 9h-1.3A8 8 0 103 16.3'></path>
              </svg>
              <span id='attachment-label' class='text-muted-foreground text-sm'>Fájlok kiválasztása (max. 5)</span>
            </label>
          </div>
          <button
            id='attachment-clear'
            type='button'
            class='text-muted-foreground hover:text-foreground hidden text-xs underline underline-offset-2'
          >
            Csatolmány eltávolítása
          </button>
        </div>

        {
          turnstileSiteKey && (
            <div class='cf-turnstile' data-sitekey={turnstileSiteKey} data-theme='light' data-language='hu' />
          )
        }

        <button
          type='submit'
          class='bg-primary text-primary-foreground hover:bg-primary/90 inline-flex rounded-full px-6 py-3 text-sm font-medium transition-colors disabled:cursor-not-allowed disabled:opacity-60'
        >
          <span class='translate-y-px'>Üzenet küldése</span>
        </button>

        <p id='contact-status' class='hidden text-sm' role='status' aria-live='polite'></p>
      </form>
    </section>
  </section>

  {turnstileSiteKey && <script src='https://challenges.cloudflare.com/turnstile/v0/api.js' async defer is:inline />}
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null
  const status = document.getElementById('contact-status') as HTMLParagraphElement | null
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null
  const attachmentInput = document.getElementById('attachment') as HTMLInputElement | null
  const attachmentLabel = document.getElementById('attachment-label') as HTMLSpanElement | null
  const attachmentClear = document.getElementById('attachment-clear') as HTMLButtonElement | null
  const elapsedInput = document.getElementById('elapsed') as HTMLInputElement | null

  const pageLoadedAt = Date.now()
  const defaultAttachmentLabel = attachmentLabel?.textContent ?? 'Fájlok kiválasztása (max. 5)'
  const MAX_ATTACHMENTS = 5

  const updateAttachmentLabel = () => {
    if (!attachmentInput || !attachmentLabel || !attachmentClear) return
    const files = attachmentInput.files

    if (files && files.length > 0) {
      const names = Array.from(files).map(f => f.name)
      attachmentLabel.textContent = names.length === 1 ? names[0] : `${names.length} fájl: ${names.join(', ')}`
      attachmentLabel.classList.remove('text-muted-foreground')
      attachmentLabel.classList.add('text-foreground', 'font-medium')
      attachmentClear.classList.remove('hidden')
    } else {
      attachmentLabel.textContent = defaultAttachmentLabel
      attachmentLabel.classList.add('text-muted-foreground')
      attachmentLabel.classList.remove('text-foreground', 'font-medium')
      attachmentClear.classList.add('hidden')
    }
  }

  attachmentInput?.addEventListener('change', () => {
    if (attachmentInput && attachmentInput.files && attachmentInput.files.length > MAX_ATTACHMENTS) {
      setStatus(`Legfeljebb ${MAX_ATTACHMENTS} fájlt csatolhatsz.`, 'error')
      attachmentInput.value = ''
    }
    updateAttachmentLabel()
  })
  attachmentClear?.addEventListener('click', () => {
    if (!attachmentInput) return
    attachmentInput.value = ''
    updateAttachmentLabel()
  })

  const setStatus = (message: string, kind: 'success' | 'error') => {
    if (!status) return
    status.textContent = message
    status.classList.remove('hidden', 'text-emerald-600', 'text-destructive')
    status.classList.add(kind === 'success' ? 'text-emerald-600' : 'text-destructive')
  }

  form?.addEventListener('submit', async event => {
    event.preventDefault()
    if (!form || !submitBtn) return

    submitBtn.disabled = true
    status?.classList.add('hidden')

    if (elapsedInput) {
      elapsedInput.value = String(Date.now() - pageLoadedAt)
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' }
      })
      const data = await response.json().catch(() => ({}))

      if (response.ok) {
        setStatus('Köszönjük! Az üzeneted megérkezett, hamarosan válaszolunk.', 'success')
        form.reset()
        updateAttachmentLabel()
      } else {
        setStatus(data.error ?? 'Nem sikerült elküldeni az üzenetet.', 'error')
      }
    } catch {
      setStatus('Hálózati hiba történt. Próbáld újra később.', 'error')
    } finally {
      submitBtn.disabled = false
    }
  })
</script>
