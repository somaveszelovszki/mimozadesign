EMAIL={YOUR_EMAIL}
LICENSE_KEY={YOUR_LICENSE_KEY}

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Sender address shown on outgoing contact-form emails.
# Must be on a domain verified in Resend (e.g. noreply@mimozadesign.hu).
CONTACT_FROM_EMAIL=Mimóza Design <noreply@mimozadesign.hu>

# Cloudflare Turnstile — anti-spam for the contact form.
# Create a (free) widget at https://dash.cloudflare.com/?to=/:account/turnstile
# The site key is public (rendered in the page); the secret key stays server-side.
# Leave both unset to disable Turnstile (honeypot + time-trap still apply).
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_xxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAA_xxxxxxxxxxxxxxxx
