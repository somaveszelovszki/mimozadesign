---
import Layout from '@/layouts/Layout.astro'
import ProductPurchase from '@/components/blocks/webshop/product-purchase'
import { products, type Product } from '@/assets/data/webshop'

export function getStaticPaths() {
  return products.map(product => ({
    params: { product: product.slug },
    props: { product }
  }))
}

interface Props {
  product: Product
}

const { product } = Astro.props as Props

const sizeParam = Astro.url.searchParams.get('size') ?? product.sizes[0].id

const pageTitle = `${product.title} | Webshop | Mimóza Design`
const pageDescription = product.description[0] ?? product.title
const pageImage = product.profileImage
---

<Layout title={pageTitle} description={pageDescription} image={pageImage}>
  <section class='bg-background text-foreground mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-18'>
    <a
      href='/webshop'
      class='text-primary hover:text-primary/80 focus-visible:ring-ring inline-flex items-center gap-2 text-sm font-medium underline-offset-4 hover:underline focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none'
    >
      Vissza a webshopba
    </a>

    <div class='mt-4 grid gap-8 lg:grid-cols-2 lg:gap-12'>
      <div class='space-y-4'>
        <div class='overflow-hidden rounded-2xl'>
          <img src={product.profileImage} alt={product.title} class='w-full object-cover' />
        </div>
        <div id='product-gallery' class='grid grid-cols-3 gap-3' data-images={JSON.stringify(product.images)}>
          {
            product.images.map((image, index) => (
              <button
                type='button'
                data-gallery-index={index}
                aria-label={`${index + 1}. kép megnyitása`}
                class='focus-visible:ring-ring hover:border-primary group block w-full cursor-pointer overflow-hidden rounded-lg border border-transparent transition-colors duration-300 outline-none focus-visible:ring-2 focus-visible:ring-offset-2'
              >
                <img
                  src={image}
                  alt={`${product.title} galéria kép ${index + 1}`}
                  class='aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-105'
                  loading='lazy'
                />
              </button>
            ))
          }
        </div>
      </div>

      <div class='space-y-6'>
        <h1 class='font-serif text-3xl font-semibold sm:text-4xl'>{product.title}</h1>
        <div class='text-muted-foreground space-y-3 text-lg'>
          {product.description.map(p => <p>{p}</p>)}
        </div>

        <ProductPurchase product={product} initialSizeId={sizeParam} client:load />
      </div>
    </div>
  </section>

  <div
    id='gallery-lightbox'
    class='bg-background/95 fixed inset-0 z-50 hidden items-center justify-center p-4 backdrop-blur-sm sm:p-8'
    aria-hidden='true'
  >
    <button
      type='button'
      id='gallery-close'
      class='bg-background/70 text-foreground hover:bg-background absolute top-4 right-4 z-10 rounded-full border px-3 py-1.5 text-sm'
      aria-label='Galéria bezárása'
    >
      Bezárás
    </button>

    <button
      type='button'
      id='gallery-prev'
      class='bg-background/70 text-foreground hover:bg-background absolute top-1/2 left-4 z-10 -translate-y-1/2 rounded-full border px-3 py-2 text-2xl leading-none'
      aria-label='Előző kép'
    >
      ‹
    </button>

    <img id='gallery-image' src='' alt='' class='max-h-[90vh] max-w-full rounded-2xl object-contain' />

    <button
      type='button'
      id='gallery-next'
      class='bg-background/70 text-foreground hover:bg-background absolute top-1/2 right-4 z-10 -translate-y-1/2 rounded-full border px-3 py-2 text-2xl leading-none'
      aria-label='Következő kép'
    >
      ›
    </button>
  </div>

  <script is:inline>
    ;(() => {
      const cleanupKey = '__mimozaProductGalleryCleanup'

      const init = () => {
        if (typeof window[cleanupKey] === 'function') {
          window[cleanupKey]()
        }

        const gallery = document.querySelector('#product-gallery')
        const lightbox = document.querySelector('#gallery-lightbox')
        const lightboxImage = document.querySelector('#gallery-image')
        const closeButton = document.querySelector('#gallery-close')
        const prevButton = document.querySelector('#gallery-prev')
        const nextButton = document.querySelector('#gallery-next')

        if (!gallery || !lightbox || !lightboxImage || !closeButton || !prevButton || !nextButton) {
          window[cleanupKey] = null
          return
        }

        const images = JSON.parse(gallery.getAttribute('data-images') || '[]')
        if (!Array.isArray(images) || images.length === 0) {
          window[cleanupKey] = null
          return
        }

        let activeIndex = 0

        const open = i => {
          activeIndex = i
          lightboxImage.setAttribute('src', images[activeIndex])
          lightboxImage.setAttribute('alt', `${activeIndex + 1}. termék galéria kép`)
          lightbox.classList.remove('hidden')
          lightbox.classList.add('flex')
          lightbox.setAttribute('aria-hidden', 'false')
          document.body.style.overflow = 'hidden'
        }
        const close = () => {
          lightbox.classList.add('hidden')
          lightbox.classList.remove('flex')
          lightbox.setAttribute('aria-hidden', 'true')
          document.body.style.overflow = ''
        }
        const shift = d => {
          activeIndex = (activeIndex + d + images.length) % images.length
          lightboxImage.setAttribute('src', images[activeIndex])
        }

        const onGalleryClick = e => {
          const t = e.target.closest('[data-gallery-index]')
          if (!t) return
          const i = Number(t.getAttribute('data-gallery-index'))
          if (!Number.isFinite(i)) return
          open(i)
        }
        const onPrev = () => shift(-1)
        const onNext = () => shift(1)
        const onLightboxClick = e => {
          if (e.target === lightbox) close()
        }
        const onKey = e => {
          if (lightbox.getAttribute('aria-hidden') === 'true') return
          if (e.key === 'Escape') close()
          else if (e.key === 'ArrowLeft') shift(-1)
          else if (e.key === 'ArrowRight') shift(1)
        }

        document.addEventListener('click', onGalleryClick)
        closeButton.addEventListener('click', close)
        prevButton.addEventListener('click', onPrev)
        nextButton.addEventListener('click', onNext)
        lightbox.addEventListener('click', onLightboxClick)
        document.addEventListener('keydown', onKey)

        window[cleanupKey] = () => {
          document.removeEventListener('click', onGalleryClick)
          closeButton.removeEventListener('click', close)
          prevButton.removeEventListener('click', onPrev)
          nextButton.removeEventListener('click', onNext)
          lightbox.removeEventListener('click', onLightboxClick)
          document.removeEventListener('keydown', onKey)
          document.body.style.overflow = ''
        }
      }

      init()
      document.addEventListener('astro:page-load', init)
    })()
  </script>
</Layout>
